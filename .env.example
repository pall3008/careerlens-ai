# Copy this file to .env and fill in your own keys.
# .env is git-ignored — never commit real keys.
#
# On Streamlit Community Cloud, do not use a .env file at all. Paste these as
# TOML into App settings -> Secrets instead:
#
#   GROQ_API_KEY = "your_key"
#   ADZUNA_APP_ID = "your_id"
#   ADZUNA_APP_KEY = "your_key"
#   ADZUNA_COUNTRY = "in"

# Required — free key from https://console.groq.com
GROQ_API_KEY=

# Optional — free key from https://developer.adzuna.com
# Without these, live jobs still work via Remotive (remote roles only).
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=in
